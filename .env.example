APP_NAME=Artemis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where invoice proof-of-payment receipts are stored. Defaults to s3 and needs
# the AWS_* credentials below; set to "local" on machines that have none.
# Not MEDIA_DISK — that one is media-library's own and moves every collection.
PROOF_OF_PAYMENT_DISK=s3
# Where checklist proof-of-completion uploads are stored. Same rules as the
# disk above: defaults to s3, set to "local" on machines with no AWS creds.
CHECKLIST_PROOF_DISK=s3
# Where course thumbnails, videos, and attachments are stored. Same rules as
# the disk above: defaults to s3, set to "local" on machines with no AWS creds.
COURSE_MEDIA_DISK=s3
# Ceiling media-library enforces on any file, separate from Laravel validation.
# Lesson videos go straight to S3 presigned and are deliberately uncapped, so
# this has to sit above whatever the largest lesson video will be.
MEDIA_MAX_FILE_SIZE=10737418240
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs instead of sending it — the local default.
# Use `brevo` to send for real through Brevo's transactional API.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be a sender Brevo has verified, or it refuses the message.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo → SMTP & API → API Keys. The v3 key, not the SMTP key.
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DISCORD_WEBHOOK_URL=
INVENTORY_DISCORD_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

N8N_WEBHOOK_URL=
# GencysERP daily sales tracker n8n flow (falls back to N8N_WEBHOOK_URL when empty).
N8N_GENCYS_DAILY_SALES_WEBHOOK_URL=
N8N_GENCYS_DAILY_SALES_CALLBACK_URL=
# Inventory items sync from Gencys ERP, fired by the "Sync from Gencys ERP"
# button on the inventory items list.
N8N_GENCYS_INVENTORY_ITEMS_WEBHOOK_URL=

# n8n's own REST API, used by the Sync Runs page to look up how an execution
# actually went and to link into the editor. Base URL of the instance (no
# /api/v1) plus a key from n8n Settings -> n8n API. Optional: without both, the
# page just doesn't offer the lookup.
N8N_API_URL=
N8N_API_KEY=

# Parcel-journey SMS provider base URLs (credentials are stored per page).
INFOTXT_BASE_URL="https://api.myinfotxt.com/v2"
SENDGATE_BASE_URL="https://sendgate-test.on-forge.com"
